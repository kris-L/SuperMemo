  /**
   * 获取圆周率指定位置开始的数字序列
   * @param startIndex 起始位置（从0开始，即小数点后第一位）
   * @param length 需要的数字长度
   * @returns 数字字符串
   */
  public static getPiDigits(startIndex: number, length: number): string {
    if (startIndex < 0 || length <= 0) {
      return '';
    }
    
    const endIndex = startIndex + length;
    if (endIndex > PiGenerator.PI_DIGITS.length) {
      // 如果超出范围，循环使用
      let result = '';
      for (let i = 0; i < length; i++) {
        const index = (startIndex + i) % PiGenerator.PI_DIGITS.length;
        result += PiGenerator.PI_DIGITS[index];
      }
      return result;
    }
    
    return PiGenerator.PI_DIGITS.substring(startIndex, endIndex);
  }

  /**
   * 生成随机数字序列
   * @param length 需要的数字长度
   * @returns 随机数字字符串
   */
  public static generateRandomDigits(length: number): string {
    let result = '';
    for (let i = 0; i < length; i++) {
      result += Math.floor(Math.random() * 10).toString();
    }
    return result;
  }
